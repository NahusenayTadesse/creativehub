# Drizzle
# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"

# The public origin, scheme included and no trailing slash.
# better-auth signs cookies against it, and adapter-node checks it on every
# form POST, so a wrong value here looks like "every submission is forbidden".
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Where uploads are written.
#
# Set this to an absolute path OUTSIDE the deploy directory. It defaults to
# `.tempFiles` relative to the working directory, which is fine for development
# and dangerous in production: a deploy that replaces the application directory
# takes every avatar, portfolio image and identity document with it.
#
# The process must be able to create it and write into it. Verification
# evidence lands in a `private/` subdirectory, served only after an
# authorisation check.
FILES_DIR="/var/lib/creator-network/files"

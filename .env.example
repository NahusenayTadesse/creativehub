# Drizzle
# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"

# The public origin, scheme included and no trailing slash.
# better-auth signs cookies against it, and adapter-node checks it on every
# form POST, so a wrong value here looks like "every submission is forbidden".
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Where uploads are written.
#
# Set this to an absolute path OUTSIDE the deploy directory. It defaults to
# `.tempFiles` relative to the working directory, which is fine for development
# and dangerous in production: a deploy that replaces the application directory
# takes every avatar, portfolio image and identity document with it.
#
# The process must be able to create it and write into it. Verification
# evidence lands in a `private/` subdirectory, served only after an
# authorisation check.
FILES_DIR="/var/lib/creator-network/files"

# Outgoing mail.
#
# Without all of SMTP_HOST, SMTP_USER and SMTP_PASSWORD the app runs normally
# and sends nothing: in-app notifications are still written, and the mail half
# is skipped with one warning per process. Password resets and address
# confirmations, which have no in-app equivalent, simply cannot complete.
#
# Port 465 is implicit TLS. Anything else is treated as STARTTLS and required
# to upgrade — the connection is never left in the clear.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""

# The name the TLS certificate is verified against, when it differs from the
# host connected to. Leave empty unless you need it.
#
# Shared hosting commonly points `mail.<yourdomain>` at a machine holding a
# certificate for the *provider's* domain, so a strict client fails on the
# altnames before it ever authenticates. Set this to a name the certificate
# actually covers — usually the reverse-DNS of the mail host — and verification
# stays fully on. Do not reach for `rejectUnauthorized: false` instead: that
# accepts any certificate from anyone on the path.
SMTP_TLS_SERVERNAME=""

# What recipients see in the From line; defaults to SMTP_USER. The address must
# be one the mailbox is permitted to send as, or the server refuses the message
# even though it accepted the password.
SMTP_FROM=""

# Chapa (payments). Only the secret key is used: this integration redirects to
# Chapa's hosted checkout, which is authorised entirely from the server. The
# public key belongs to the inline widget, which this app does not use.
#
# Without CHAPA_SECRET_KEY the pay button is not drawn and operators record
# deposits by hand, exactly as before payments were connected.
CHAPA_PUBLIC_KEY=""
CHAPA_SECRET_KEY=""

# Optional. The webhook signing secret from the Chapa dashboard — separate from
# the API key above.
#
# When set, a webhook whose signature does not match is refused. When unset,
# signatures are not checked, and that is survivable here because the webhook
# body is never believed: it is read for a transaction reference and nothing
# else, and the outcome is decided by asking Chapa directly. A forged request
# can therefore make the app ask a question, never assert an answer.
CHAPA_WEBHOOK_SECRET=""
